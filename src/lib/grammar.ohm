Terminal {

  // The parser is line-based: the source is split on newlines and each line is
  // matched on its own. A bad line is reported on its own and the rest of the
  // document keeps working, which matters when parsing on every keystroke.
  line
    = commentLine
    | blockLine
    | choiceLine
    | divertLine
    | textLine
    | tagLine
    | blankLine

  commentLine = indent "//" any*
  blockLine   = indent "=" hs* ident hs* tags
  choiceLine  = indent "*" hs* body divert? tags
  divertLine  = indent divert tags
  // `~("=" ~"=")` keeps a malformed header (`= 9lives`) an error instead of
  // silently becoming body text, while leaving `=== SYSTEM ===` rules alone.
  textLine    = indent ~("=" ~"=") body tags
  tagLine     = indent tagItem+   // a directive on its own line, e.g. `#clear`
  blankLine   = hs*

  divert = "->" hs* ident hs*

  // Text is anything up to a tag, an interpolation or a divert arrow. An
  // escape wins over all three, so `chunk` has to stop in front of one.
  body    = segment+
  segment = escape | interp | chunk
  interp  = "{" hs* ident hs* "}"
  chunk   = (~("#" | "{" | "->" | escape) any)+

  // A backslash prints the next character literally, but only for characters
  // that mean something to the parser. Everywhere else a backslash is just a
  // backslash, so a terminal can print `C:\Users` without doubling anything.
  // The list is mirrored by ESCAPABLE in Parser.ts -- change both together.
  escape    = "\\" escapable
  escapable = "#" | "{" | "}" | "=" | "*" | "-" | "/"

  tags    = tagItem*
  tagItem = pairTag | tag
  // The two shapes a tag can take. No tag *name* appears here: which names are
  // real, which shape each one takes and what it does are all in tags.ts, so
  // adding a tag needs no grammar change. A pair keeps its spaces because the
  // value runs to the next tag; ordinary arguments are split on whitespace.
  pairTag  = "#" ident hs+ ident hs* "=" hs* value
  tag      = "#" ident tagArg* hs*
  tagArg   = hs+ argToken
  argToken = (~(hs | "#") any)+

  // Stops at a `->` as well as at the next tag: on a choice the inline divert
  // is written before the tags, so `#if x = y -> there` is a misplaced divert
  // rather than a value of "y -> there". Failing the line says so; a value
  // that really wants an arrow escapes it as `\->`.
  value  = (escape | ~("#" | "->") any)+
  ident  = (letter | "_") (alnum | "_")*
  indent = hs*
  hs     = " " | "\t"
}
